{
  "name": "pendulum-studio",
  "version": "0.2.0",
  "description": "교육용 회전 도립 진자 키트 강화학습 앱",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Pendulum Studio",
  "license": "MIT",
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^26.18.0"
  },
  "optionalDependencies": {
    "serialport": "12.0.0"
  },
  "build": {
    "appId": "cc.pendulumstudio.app",
    "productName": "Pendulum Studio",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pendulum Studio",
      "artifactName": "PendulumStudio-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.ico"
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
